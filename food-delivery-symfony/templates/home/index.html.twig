{% extends 'base.html.twig' %}

{% block title %}Food Delivery - Trang chủ{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-white mb-4">
                    Đặt đồ ăn ngon tại nhà
                </h1>
                <p class="lead text-white mb-4">
                    Khám phá hàng trăm món ăn ngon từ các nhà hàng uy tín.
                    Đặt hàng dễ dàng, giao hàng nhanh chóng!
                </p>
                <a href="{{ path('app_restaurant_index') }}" class="btn btn-warning btn-lg">
                    <i class="fas fa-utensils me-2"></i>Đặt hàng ngay
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://via.placeholder.com/400x300/FF6B6B/FFFFFF?text=Food+Delivery" alt="Food Delivery" class="img-fluid" style="max-width: 400px;">
            </div>
        </div>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Tại sao chọn chúng tôi?</h2>
        <div class="row">
            <div class="col-md-4 text-center mb-4">
                <div class="feature-icon mb-3">
                    <i class="fas fa-clock fa-3x text-primary"></i>
                </div>
                <h5>Giao hàng nhanh</h5>
                <p>Giao hàng trong vòng 30-45 phút</p>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="feature-icon mb-3">
                    <i class="fas fa-utensils fa-3x text-primary"></i>
                </div>
                <h5>Đa dạng món ăn</h5>
                <p>Hàng trăm món ăn từ các nhà hàng uy tín</p>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="feature-icon mb-3">
                    <i class="fas fa-mobile-alt fa-3x text-primary"></i>
                </div>
                <h5>Đặt hàng dễ dàng</h5>
                <p>Giao diện thân thiện, dễ sử dụng</p>
            </div>
        </div>
    </div>
</section>

<footer class="bg-dark text-white py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h5>Food Delivery</h5>
                <p>Đặt đồ ăn ngon tại nhà</p>
            </div>
            <div class="col-md-6 text-md-end">
                <p>&copy; 2024 Food Delivery. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>

<style>
.hero-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 100px 0;
    color: white;
}

.min-vh-75 {
    min-height: 75vh;
}

.feature-icon {
    color: #007bff;
}
</style>
{% endblock %}
